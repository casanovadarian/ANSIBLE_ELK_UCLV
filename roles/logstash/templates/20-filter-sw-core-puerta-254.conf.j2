filter {
  if [source_ip] == "{{ logstash_switch_core_ip }}" {
    mutate {
      replace => { "index_name" => "uclv-core-switch-254" }
    }
    if [syslog_message] =~ /EVENT <UpDown>/ {
      grok {
        match => {
          "syslog_message" => "EVENT <UpDown> %{NOTSPACE:interface} index %{INT:if_index} <%{DATA:if_traffic_type}> address #%{INT:addr_id} %{MAC:mac_address}"
        }
        add_tag => ["juniper_interface_event"]
      }
    }
    else if [syslog_message] =~ /STP/ {
      grok {
        match => {
          "syslog_message" => [
            "STP handler: IFD =%{DATA:interface}, op=%{WORD:stp_op}, state=%{WORD:stp_state}, Topo change generation=%{INT:stp_topo_gen}",
            "\*%{DATA:stp_event}\*, notify to other modules"
          ]
        }
        add_tag => ["juniper_stp_event"]
      }
    }
    else if [syslog_message] =~ /Decode ifd/ {
      grok {
        match => {
          "syslog_message" => "Decode ifd %{NOTSPACE:interface} index %{INT:if_index}: ifdm_flags %{WORD:if_flags}"
        }
        add_tag => ["juniper_decode_event"]
      }
    }
    if "juniper_interface_event" in [tags] or "juniper_stp_event" in [tags] or "juniper_decode_event" in [tags] {
      mutate {
        add_tag => ["log_procesado"]
      }
    }
  }
}