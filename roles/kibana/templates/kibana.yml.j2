# {{ ansible_managed }}
server.port: {{ kibana_port }}
server.host: "{{ kibana_host }}"
server.name: "{{ inventory_hostname }}"

# Configuración de Elasticsearch
elasticsearch.hosts: [{% for host in groups['elk'] %}"https://{{ hostvars[host]['ansible_default_ipv4']['address'] }}:9200"{% if not loop.last %}, {% endif %}{% endfor %}]

elasticsearch.username: "kibana_system"
elasticsearch.password: "{{ kibana_system_password }}"

# Configuración SSL
elasticsearch.ssl.certificateAuthorities: [ "/etc/kibana/certs/elasticsearch-ca.pem" ]
elasticsearch.ssl.verificationMode: certificate

# Configuración de logging
logging:
  appenders:
    file:
      type: file
      fileName: /var/log/kibana/kibana.log
      layout:
        type: json
  root:
    appenders: [default, file]